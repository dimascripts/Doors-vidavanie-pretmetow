    btnFloor.Parent = frame

    local b1Corner = Instance.new("UICorner")
    b1Corner.CornerRadius = UDim.new(0, 4)
    b1Corner.Parent = btnFloor

    -- Кнопка "Сразу в инвентарь"
    local btnInv = Instance.new("TextButton")
    btnInv.Size = UDim2.new(0.28, 0, 0.8, 0)
    btnInv.Position = UDim2.new(0.70, 0, 0.1, 0)
    btnInv.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    btnInv.Text = "🎒 В руки"
    btnInv.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnInv.TextSize = 11
    btnInv.Font = Enum.Font.SourceSans
    btnInv.Parent = frame

    local b2Corner = Instance.new("UICorner")
    b2Corner.CornerRadius = UDim.new(0, 4)
    b2Corner.Parent = btnInv

    -- Обработка событий
    btnFloor.MouseButton1Click:Connect(function()
        SpawnPickableItem(itemName, text, color)
    end)

    btnInv.MouseButton1Click:Connect(function()
        pcall(function()
            local DoorsSpawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/everestspawners/DoorsItemSpawner/main/source.lua"))()
            if DoorsSpawner and DoorsSpawner.Give then
                DoorsSpawner.Give(itemName)
            end
        end)
    end)
end

