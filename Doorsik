-- 4. ЛОГИКА СОЗДАНИЯ И ПОДБОРА ПРЕДМЕТА С ПОЛА
---------------------------------------------------------
local function SpawnPickableItem(itemName, itemDisplayName, color)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- Точка под ногами игрока
    local spawnPos = char.HumanoidRootPart.CFrame * CFrame.new(0, -2, -2)

    -- Переменная под созданный Tool
    local spawnedTool = nil

    -- Загрузка предмета из спавнера DOORS
    pcall(function()
        local DoorsSpawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/everestspawners/DoorsItemSpawner/main/source.lua"))()
        if DoorsSpawner and DoorsSpawner.Give then
            DoorsSpawner.Give(itemName)
            task.wait(0.1)
            
            -- Поиск полученного предмета в инвентаре
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if bp then
                spawnedTool = bp:FindFirstChild(itemName) or bp:FindFirstChildWhichIsA("Tool")
            end
        end
    end)

    -- Если стандартный спавнер недоступен, создаем кастомный подбираемый предмет
    if not spawnedTool then
        spawnedTool = Instance.new("Tool")
        spawnedTool.Name = itemDisplayName
        
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(1, 1, 1)
        handle.Color = color
        handle.Material = Enum.Material.Neon
        handle.Parent = spawnedTool
    end

    -- Выкладываем Tool на пол в мир
    spawnedTool.Parent = Workspace
    
    local handlePart = spawnedTool:FindFirstChild("Handle") or spawnedTool:FindFirstChildWhichIsA("BasePart")
    if handlePart then
        handlePart.CFrame = spawnPos
        handlePart.Anchored = false
        handlePart.CanCollide = true

        -- Удаляем старый prompt, если он был
        if handlePart:FindFirstChild("PickPrompt") then
            handlePart.PickPrompt:Destroy()
        end

        -- Добавляем ProximityPrompt для подбора предмета
        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "PickPrompt"
        prompt.ActionText = "Взять " .. itemDisplayName
        prompt.ObjectText = "Предмет DOORS"
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 8
        prompt.Parent = handlePart

        -- При нажатии (подборе) кладем предмет в инвентарь игрока
        local connection
        connection = prompt.Triggered:Connect(function(playerWhoTriggered)
            if playerWhoTriggered == LocalPlayer then
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                if backpack then
                    spawnedTool.Parent = backpack
                    prompt:Destroy()
                    if connection then connection:Disconnect() end
                end
            end
        end)
    end
end

